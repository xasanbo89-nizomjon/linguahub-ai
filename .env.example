# LinguaHub AI - backend environment configuration.
# Copy this file to .env and fill in real values. Never commit .env.
#
# .env must also never be bundled into an Electron package - a Phase 8
# packaging verification found the real .env being swept into the packaged
# app by electron-builder's default file inclusion (fixed via an explicit
# "files" allowlist in package.json's "build" config; see
# docs/phase-08-final-hardening.md). If you change that allowlist, re-run
# `npx electron-builder --dir` and inspect the resulting app.asar
# (`npx asar list dist/win-unpacked/resources/app.asar`) to confirm .env
# still isn't included before trusting a new build.

# Port the Express backend listens on.
PORT=3000

# development | production
NODE_ENV=development

# Comma-separated list of additional frontend origins allowed by CORS,
# on top of the built-in local dev defaults (127.0.0.1:5500, localhost:5500,
# 127.0.0.1:3000, localhost:3000, capacitor://localhost, http://localhost).
# Example: FRONTEND_ORIGINS=https://app.example.com,https://example.com
FRONTEND_ORIGINS=

# Required. OpenAI API key used server-side only - never sent to the frontend.
OPENAI_API_KEY=

# Optional tuning (safe defaults are used if omitted).
# Maximum characters allowed in a single chat message.
MAX_MESSAGE_LENGTH=8000
# Rate limit window, in milliseconds, per client IP.
RATE_LIMIT_WINDOW_MS=60000
# Maximum chat requests allowed per client IP per window.
RATE_LIMIT_MAX_REQUESTS=30

# --- Firebase Admin (server-only; never expose these to the frontend) ---
# Required only for GET /api/auth/me and identity-aware chat requests to
# work; guest chat functions normally without any of these set. Use EITHER
# GOOGLE_APPLICATION_CREDENTIALS (path to a service-account JSON key file,
# recommended for local dev - see .gitignore, this file must never be
# committed) OR the three discrete FIREBASE_* variables below (recommended
# for most hosting platforms' env-var-based secret storage). If both are
# set, GOOGLE_APPLICATION_CREDENTIALS takes precedence.
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the full PEM private key. If your platform can't store real
# newlines, use literal \n sequences - the backend normalizes them.
FIREBASE_PRIVATE_KEY=
# Optional: set to "true" to also check whether the ID token was revoked
# (one extra network round trip per verification). Defaults to false.
FIREBASE_CHECK_REVOKED=

# Note (Phase 10): native Android Google sign-in (@capacitor-firebase/
# authentication) does NOT use any variable in this file - it reads its
# Firebase project config from android/app/google-services.json (a
# downloaded file, not an env var; see docs/capacitor-native-auth.md and
# docs/mobile-security-report.md). The FIREBASE_* variables above remain
# server-only Admin credentials, used identically regardless of whether
# the client obtained its ID token via the web popup flow or native
# Android sign-in.

# --- Production hardening (Phase 11) - all optional, safe defaults apply ---
# See docs/production-environment.md for the full explanation of every
# variable below, including exactly what's validated and what happens
# when a value is missing/malformed.

# REQUIRED when NODE_ENV=production (a startup error otherwise, not a
# silent fallback): comma-separated list of exact production frontend
# origins allowed by CORS, e.g. https://app.example.com,https://example.com
# (bare origin only - no path, no trailing slash). The built-in dev
# defaults (127.0.0.1/localhost) are local-development-only and do not
# count toward this requirement.
FRONTEND_ORIGINS=

# Reverse-proxy trust for req.ip (used by rate limiting). Defaults to 0
# (trust nothing). Behind exactly one reverse proxy/load balancer/ingress
# (the expected production topology - see docs/production-network-and-cors.md),
# set to 1. Never set to "true" (trusts an unbounded, spoofable chain)
# unless the deployment topology genuinely requires it.
TRUST_PROXY=

# debug | info | warn | error | silent. Defaults to info.
LOG_LEVEL=

# Bounds any single HTTP request/response cycle at the server level, in
# ms. Defaults to 120000 (distinct from each AI mode's own generation
# timeout in lib/aiModes.js).
REQUEST_TIMEOUT_MS=

# How long graceful shutdown (SIGTERM/SIGINT) waits before force-closing
# remaining connections, in ms. Defaults to 10000.
SHUTDOWN_TIMEOUT_MS=

# A basic per-IP request budget applied to every route (a DoS backstop).
# Defaults to 300 requests/minute.
GENERAL_RATE_LIMIT_MAX_REQUESTS=

# A stricter, separate budget that only counts Deep Thinking mode
# requests (the most expensive enabled mode - see docs/production-rate-limiting.md).
# Defaults to 10 requests per RATE_LIMIT_WINDOW_MS.
DEEP_THINKING_RATE_LIMIT_MAX_REQUESTS=

# Optional shared rate-limit store URL (e.g. redis://...) for a
# horizontally-scaled, multi-instance deployment. NOT currently wired into
# server.js's actual limiters (contract only - see
# docs/production-rate-limiting.md) - setting this has no effect yet.
RATE_LIMIT_STORE_URL=

# Recognized but currently UNUSED - no PostgreSQL client is wired into
# this application (see docs/production-environment.md, "Database").
# Setting this produces an explicit startup warning saying so, never a
# claim of active persistence.
DATABASE_URL=

# --- Trusted LinguaHub page context (backend-to-backend only) ---
# Optional. A single shared secret that authenticates LinguaHub's OWN
# backend as a caller - completely separate from end-user Firebase auth
# above, and unrelated to it. Only requests that include a "context" field
# in the POST /api/chat or /api/chat/stream body are ever checked against
# this value (sent back as the X-LinguaHub-Internal-Token request header);
# ordinary public/guest chat requests with no context never touch this at
# all and keep working exactly the same whether or not this is set.
# If unset, no request can ever supply trusted context (fails closed, not
# open) - guest/public chat is completely unaffected either way.
# Generate a long, random value (e.g. `openssl rand -hex 32`) and never
# commit the real value - this file only documents the variable name.
LINGUAHUB_INTERNAL_TOKEN=

# Speech-to-text (POST /api/transcribe, used by Electron and browsers without
# Web Speech). Requests per RATE_LIMIT_WINDOW_MS per user/IP; defaults to 20.
TRANSCRIBE_RATE_LIMIT_MAX_REQUESTS=
# Optional: transcription model (default whisper-1).
TRANSCRIBE_MODEL=

# Free sample corrections per IP address per day (the landing page's
# "try it"; the page offers one). Defaults to 3.
TRY_RATE_LIMIT_MAX_REQUESTS=

# --- Optional sign-in ---
# "true": every AI request needs a signed-in user (the strict mode). "false" (default): guests can use
# the app too, with a smaller daily allowance counted per hashed IP address (Firestore: guestUsage).
REQUIRE_SIGN_IN=
# Guest limits: AI requests per day per IP address, picture messages per day, and a cap for ALL guests
# together per day (when it is reached guests are asked to sign in). Same midnight (Tashkent) reset.
GUEST_DAILY_LIMIT=
GUEST_IMAGE_DAILY_LIMIT=
GUEST_GLOBAL_DAILY_CAP=
# A secret string mixed into the IP hash, so the stored hashes cannot be recomputed from IP lists.
GUEST_SALT=

# --- Plans (Phase 6A) ---
# Free AI requests per user per day. The day ends at midnight in Asia/Tashkent.
# Counted in Firestore (users/{uid}), so the Firebase Admin variables above are required.
FREE_DAILY_LIMIT=
# Price text shown in the paywall. Defaults to "Coming soon".
PREMIUM_PRICE_LABEL=
# Where the "Get Premium" dialog sends people (must be https://, e.g. your Telegram link).
PREMIUM_CONTACT_URL=
